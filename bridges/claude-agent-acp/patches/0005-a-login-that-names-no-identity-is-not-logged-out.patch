@@ -2159,6 +2160,9 @@ export class ClaudeAcpAgent {
   /** Same, for the "the CLI probe timed out" warning: a wedged CLI stays wedged
    *  and would otherwise warn once per probe, i.e. once per user prompt. */
   private loggedProbeTimeout = false;
+  /** Same, for the "CLI is logged in but names no identity" note (token auth):
+   *  every prompt re-reads the store, and every read says the same. */
+  private loggedUnattributedLogin = false;
   /** Grace period before a `session/cancel` forces a wedged prompt loop to
    *  return "cancelled". See {@link DEFAULT_FORCE_CANCEL_GRACE_MS}. Mutable so
    *  tests can shrink it. */
@@ -2664,7 +2668,14 @@ export class ClaudeAcpAgent {
     }
     const status = fromCliStatus(stdout);
     if (!status) {
-      this.logger.error("claude auth status returned unparseable output");
+      if (!cliStatusLoggedIn(stdout)) {
+        this.logger.error("claude auth status returned unparseable output");
+      } else if (!this.loggedUnattributedLogin) {
+        this.loggedUnattributedLogin = true;
+        this.logger.log(
+          "[authStatus] the CLI is logged in without naming an identity; nothing to report",
+        );
+      }
       return undefined;
     }
     if (epoch !== this.authEpoch) {
