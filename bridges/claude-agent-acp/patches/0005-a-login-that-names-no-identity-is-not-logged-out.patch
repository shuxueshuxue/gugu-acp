+/** Does this `claude auth status --json` output say the CLI is logged in? Tells
+ *  a login that names no identity apart from output that could not be read. */
+export function cliStatusLoggedIn(stdout: string): boolean {
+  try {
+    const parsed: unknown = JSON.parse(stdout);
+    return Boolean(
+      parsed && typeof parsed === "object" && (parsed as CliAuthStatus).loggedIn === true,
+    );
+  } catch {
+    return false;
+  }
+}
+
 /** Single mapping table shared by both sources; see the `kind`/`label` table in
  *  `extension-authstatus-meta.md`. Order matters: a 3P backend or a gateway
  *  decides the kind before any firstParty identity fields are considered, and
@@ -224,7 +238,7 @@ function mapAuthFields(fields: {
   apiKeySource?: string;
   email?: string;
   organization?: string;
-}): AuthStatus {
+}): AuthStatus | undefined {
   const { apiProvider, subscriptionType, apiKeySource, email, organization } = fields;
 
   if (apiProvider === "gateway") {
@@ -256,7 +270,11 @@ function mapAuthFields(fields: {
       account,
     };
   }
-  return notLoggedInAuthStatus();
+  // Logged in, but nothing says as whom. A bearer token (`ANTHROPIC_AUTH_TOKEN`,
+  // `CLAUDE_CODE_OAUTH_TOKEN`) reads `loggedIn: true, authMethod: "oauth_token"`
+  // with no plan and no key source. Like an `AccountInfo` with no identity
+  // signal, that is no information — never `none`, which claims "logged out".
+  return undefined;
 }
 
