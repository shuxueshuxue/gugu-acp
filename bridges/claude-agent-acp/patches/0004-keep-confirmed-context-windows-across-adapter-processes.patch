+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { PersistedContextWindows } from "../context-window-store.js";
+
+describe("PersistedContextWindows", () => {
+  let dir: string;
+  const file = () => path.join(dir, "context-windows.json");
+
+  beforeEach(() => {
+    dir = fs.mkdtempSync(path.join(os.tmpdir(), "acp-context-windows-"));
+  });
+
+  afterEach(() => {
+    fs.rmSync(dir, { recursive: true, force: true });
+  });
+
+  it("carries a confirmed window from one process's store to another's", () => {
+    const writer = new PersistedContextWindows(dir, vi.fn());
+    writer.set("backend\0claude-opus-5-5", 1_000_000);
+
+    const reader = new PersistedContextWindows(dir, vi.fn());
+    expect(reader.get("backend\0claude-opus-5-5")).toBe(1_000_000);
+    expect(reader.get("backend\0claude-sonnet-5")).toBeUndefined();
+  });
+
+  it("keeps entries written by other stores sharing the directory", () => {
+    new PersistedContextWindows(dir, vi.fn()).set("a\0m1", 200_000);
+    new PersistedContextWindows(dir, vi.fn()).set("a\0m2", 1_000_000);
+
+    const reader = new PersistedContextWindows(dir, vi.fn());
+    expect(reader.get("a\0m1")).toBe(200_000);
+    expect(reader.get("a\0m2")).toBe(1_000_000);
+  });
+
+  it("writes only hashes of the keys, which embed credentials", () => {
+    new PersistedContextWindows(dir, vi.fn()).set("sk-ant-secret\0claude-opus-5-5", 1_000_000);
+
+    const raw = fs.readFileSync(file(), "utf8");
+    expect(raw).not.toContain("sk-ant-secret");
+    expect(raw).not.toContain("claude-opus-5-5");
+  });
+
+  it("reads and writes nothing without a directory", () => {
+    const store = new PersistedContextWindows(undefined, vi.fn());
+    store.set("a\0m", 1_000_000);
+    expect(store.get("a\0m")).toBeUndefined();
+    expect(fs.readdirSync(dir)).toEqual([]);
+  });
+
+  it("reports a malformed file, reads it as empty, and replaces it on the next write", () => {
+    fs.writeFileSync(file(), "{not json");
+    const onError = vi.fn();
+    const store = new PersistedContextWindows(dir, onError);
+
+    expect(store.get("a\0m")).toBeUndefined();
+    expect(onError).toHaveBeenCalled();
+
+    store.set("a\0m", 1_000_000);
+    expect(new PersistedContextWindows(dir, vi.fn()).get("a\0m")).toBe(1_000_000);
+  });
+
+  it("ignores non-positive windows", () => {
+    const store = new PersistedContextWindows(dir, vi.fn());
+    store.set("a\0m", 0);
+    expect(fs.existsSync(file())).toBe(false);
+  });
+
+  it("clear forgets every window", () => {
+    const store = new PersistedContextWindows(dir, vi.fn());
+    store.set("a\0m", 1_000_000);
+    store.clear();
+    expect(new PersistedContextWindows(dir, vi.fn()).get("a\0m")).toBeUndefined();
+  });
+});
