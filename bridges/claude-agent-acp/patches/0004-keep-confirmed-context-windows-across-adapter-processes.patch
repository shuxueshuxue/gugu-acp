diff --git a/src/context-window-store.ts b/src/context-window-store.ts
new file mode 100644
index 0000000..ad3ac13
--- /dev/null
+++ b/src/context-window-store.ts
@@ -0,0 +1,107 @@
+import { createHash } from "node:crypto";
+import { mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from "node:fs";
+import * as path from "node:path";
+
+/**
+ * Where context windows that Claude has confirmed (`result.modelUsage`) outlive
+ * this adapter process.
+ *
+ * The in-memory cache in acp-agent.ts lets a session seed its window from an
+ * earlier turn on the same (backend, model) — but only inside one process. A
+ * client that runs one adapter process per session starts every session with an
+ * empty cache, so every first turn streams the name-based guess instead (200000
+ * for Opus 5.5 under Claude Code 2.1.282: its window is 1M, its ids `opus` /
+ * `claude-opus-5-5` carry no "1m"). Naming a directory here makes the confirmed
+ * windows survive process boundaries. Unset, nothing is read or written.
+ *
+ * Only the hash of each cache key is stored: the keys embed credential env
+ * values (API keys, auth tokens), which must never reach disk.
+ */
+export const CONTEXT_WINDOW_STATE_DIR_ENV = "CLAUDE_AGENT_ACP_STATE_DIR";
+
+const FILE_NAME = "context-windows.json";
+
+type StoredWindows = { version: 1; windows: Record<string, number> };
+
+export class PersistedContextWindows {
+  private readonly file: string | undefined;
+
+  constructor(
+    dir: string | undefined,
+    private readonly onError: (message: string, error?: unknown) => void,
+  ) {
+    this.file = dir?.trim() ? path.join(dir.trim(), FILE_NAME) : undefined;
+  }
+
+  get(cacheKey: string): number | undefined {
+    if (!this.file) return undefined;
+    const window = this.load(this.file)[hashKey(cacheKey)];
+    return typeof window === "number" && window > 0 ? window : undefined;
+  }
+
+  set(cacheKey: string, window: number): void {
+    if (!this.file || !(window > 0)) return;
+    const windows = this.load(this.file);
+    const key = hashKey(cacheKey);
+    if (windows[key] === window) return;
+    windows[key] = window;
+    this.save(this.file, windows);
+  }
+
+  clear(): void {
+    if (!this.file) return;
+    try {
+      rmSync(this.file, { force: true });
+    } catch (error) {
+      this.onError(`could not clear ${this.file}`, error);
+    }
+  }
+
+  /** Read on every call: other adapter processes write the same file. Unreadable or
+   *  malformed content is reported and read as empty — the window then comes from this
+   *  turn's result, exactly as without persistence. A missing file is the first run. */
+  private load(file: string): Record<string, number> {
+    let raw: string;
+    try {
+      raw = readFileSync(file, "utf8");
+    } catch (error) {
+      if ((error as { code?: unknown }).code !== "ENOENT") {
+        this.onError(`could not read ${file}`, error);
+      }
+      return {};
+    }
+    try {
+      const parsed = JSON.parse(raw) as Partial<StoredWindows> | null;
+      if (parsed?.version === 1 && parsed.windows && typeof parsed.windows === "object") {
+        return { ...parsed.windows };
+      }
+      this.onError(`ignoring ${file}: not a version 1 context-window file`);
+    } catch (error) {
+      this.onError(`ignoring ${file}: not valid JSON`, error);
+    }
+    return {};
+  }
+
+  /** Whole-file write through temp + rename, so a reader in another process never sees a
+   *  torn file. Two processes confirming at the same instant can drop one entry; that
+   *  costs one more first-turn guess, never a wrong window. */
+  private save(file: string, windows: Record<string, number>): void {
+    const temp = `${file}.${process.pid}.tmp`;
+    try {
+      mkdirSync(path.dirname(file), { recursive: true });
+      writeFileSync(temp, JSON.stringify({ version: 1, windows } satisfies StoredWindows), "utf8");
+      renameSync(temp, file);
+    } catch (error) {
+      this.onError(`could not write ${file}`, error);
+      try {
+        rmSync(temp, { force: true });
+      } catch {
+        // The write error above is the one worth reporting.
+      }
+    }
+  }
+}
+
+function hashKey(cacheKey: string): string {
+  return createHash("sha256").update(cacheKey).digest("hex");
+}
