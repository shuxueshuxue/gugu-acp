+++ b/src/tests/context-window-persistence.test.ts
@@ -0,0 +1,190 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { randomUUID } from "node:crypto";
+import type { AcpClient, ClaudeAcpAgent as ClaudeAcpAgentType } from "../acp-agent.js";
+import { CONTEXT_WINDOW_STATE_DIR_ENV } from "../context-window-store.js";
+import { Pushable } from "../utils.js";
+import { wrapQuery } from "./session-doubles.js";
+
+// A model whose id and description carry no "1m", so the name-based guess is the
+// 200000 default while the window Claude reports is 1M (Opus 5.5 under Claude Code
+// 2.1.282 has exactly this shape).
+const MODEL = "claude-opus-5-5";
+
+vi.mock("@anthropic-ai/claude-agent-sdk", async () => {
+  const actual = await vi.importActual<typeof import("@anthropic-ai/claude-agent-sdk")>(
+    "@anthropic-ai/claude-agent-sdk",
+  );
+  const { makeMockQuery } = await import("./helpers.js");
+  return {
+    ...actual,
+    query: () =>
+      makeMockQuery({
+        initializationResult: async () => ({
+          models: [{ value: MODEL, displayName: "Opus 5.5", description: "Most capable" }],
+        }),
+      }),
+  };
+});
+
+vi.mock("../tools.js", async () => {
+  const actual = await vi.importActual<typeof import("../tools.js")>("../tools.js");
+  return { ...actual, registerHookCallback: vi.fn() };
+});
+
+/** A fresh module graph stands in for a fresh adapter process: the in-memory
+ *  window cache starts empty, as it does in every process a client spawns. */
+async function newAdapterProcess() {
+  vi.resetModules();
+  const { ClaudeAcpAgent } = await import("../acp-agent.js");
+  const updates: any[] = [];
+  const client = {
+    sessionUpdate: async (notification: any) => {
+      updates.push(notification);
+    },
+  } as unknown as AcpClient;
+  const agent: ClaudeAcpAgentType = new ClaudeAcpAgent(client, { log: () => {}, error: () => {} });
+  const { sessionId } = await agent.newSession({ cwd: process.cwd(), mcpServers: [] });
+  return { agent, sessionId, updates };
+}
+
+/** Run one turn on a real session: message_start (mid-turn usage), then a result
+ *  whose modelUsage reports `window` — the real window Claude confirms. */
+async function runTurn(agent: ClaudeAcpAgentType, sessionId: string, window = 1_000_000) {
+  const session = agent.sessions[sessionId];
+  const input = new Pushable<any>();
+  async function* messages() {
+    const { value: userMessage } = await input[Symbol.asyncIterator]().next();
+    yield {
+      type: "user",
+      message: userMessage.message,
+      parent_tool_use_id: null,
+      uuid: userMessage.uuid,
+      session_id: sessionId,
+      isReplay: true,
+    };
+    const usage = {
+      input_tokens: 40_000,
+      output_tokens: 10,
+      cache_read_input_tokens: 0,
+      cache_creation_input_tokens: 0,
+    };
+    yield {
+      type: "stream_event",
+      parent_tool_use_id: null,
+      uuid: randomUUID(),
+      session_id: sessionId,
+      event: { type: "message_start", message: { model: MODEL, usage } },
+    };
+    yield {
+      type: "result",
+      subtype: "success",
+      stop_reason: "end_turn",
+      is_error: false,
+      result: "",
+      errors: [],
+      duration_ms: 0,
+      duration_api_ms: 0,
+      num_turns: 1,
+      total_cost_usd: 0.01,
+      usage,
+      modelUsage: {
+        [MODEL]: {
+          inputTokens: 40_000,
+          outputTokens: 10,
+          cacheReadInputTokens: 0,
+          cacheCreationInputTokens: 0,
+          webSearchRequests: 0,
+          costUSD: 0.01,
+          contextWindow: window,
+          maxOutputTokens: 64_000,
+        },
+      },
+      permission_denials: [],
+      uuid: randomUUID(),
+      session_id: sessionId,
+    };
+    yield { type: "system", subtype: "session_state_changed", state: "idle" };
+  }
+  // Keep the session-level calls newSession() scheduled on the original query answerable.
+  session.query = Object.assign(wrapQuery(messages()), {
+    supportedCommands: async () => [],
+    mcpServerStatus: async () => [],
+  });
+  session.input = input;
+  await agent.prompt({ sessionId, prompt: [{ type: "text", text: "hi" }] });
+}
+
+const usageUpdates = (updates: any[]) =>
+  updates.filter((u) => u.update?.sessionUpdate === "usage_update").map((u) => u.update);
+
+describe("context windows across adapter processes", () => {
+  let stateDir: string;
+  let previous: string | undefined;
+
+  beforeEach(() => {
+    stateDir = fs.mkdtempSync(path.join(os.tmpdir(), "acp-state-"));
+    previous = process.env[CONTEXT_WINDOW_STATE_DIR_ENV];
+    process.env[CONTEXT_WINDOW_STATE_DIR_ENV] = stateDir;
+  });
+
+  afterEach(() => {
+    if (previous === undefined) delete process.env[CONTEXT_WINDOW_STATE_DIR_ENV];
+    else process.env[CONTEXT_WINDOW_STATE_DIR_ENV] = previous;
+    fs.rmSync(stateDir, { recursive: true, force: true });
+  });
+
+  it("marks the guessed window until Claude confirms it", async () => {
+    const first = await newAdapterProcess();
+    await runTurn(first.agent, first.sessionId);
+
+    const [midTurn, atResult] = usageUpdates(first.updates);
+    expect(midTurn.size).toBe(200_000);
+    expect(midTurn._meta?.["_claude/contextWindowEstimated"]).toBe(true);
+    expect(atResult.size).toBe(1_000_000);
+    expect(atResult._meta?.["_claude/contextWindowEstimated"]).toBeUndefined();
+  });
+
+  it("a later process starts its sessions on the window an earlier one confirmed", async () => {
+    const first = await newAdapterProcess();
+    await runTurn(first.agent, first.sessionId);
+
+    const second = await newAdapterProcess();
+    expect(second.agent.sessions[second.sessionId].contextWindowSize).toBe(1_000_000);
+    await runTurn(second.agent, second.sessionId);
+
+    for (const update of usageUpdates(second.updates)) {
+      expect(update.size).toBe(1_000_000);
+      expect(update._meta?.["_claude/contextWindowEstimated"]).toBeUndefined();
+    }
+  });
+
+  it("a seeded window is still checked against every result, and the result wins", async () => {
+    // An earlier process confirmed 1M; the account has since lost the 1M lane.
+    const first = await newAdapterProcess();
+    await runTurn(first.agent, first.sessionId);
+
+    const second = await newAdapterProcess();
+    await runTurn(second.agent, second.sessionId, 200_000);
+    const [midTurn, atResult] = usageUpdates(second.updates);
+    expect(midTurn.size).toBe(1_000_000);
+    expect(atResult.size).toBe(200_000);
+    expect(second.agent.sessions[second.sessionId].contextWindowSize).toBe(200_000);
+
+    // The correction is what the next process starts from.
+    const third = await newAdapterProcess();
+    expect(third.agent.sessions[third.sessionId].contextWindowSize).toBe(200_000);
+  });
+
+  it("without a state dir each process learns the window on its own", async () => {
+    delete process.env[CONTEXT_WINDOW_STATE_DIR_ENV];
+    const first = await newAdapterProcess();
+    await runTurn(first.agent, first.sessionId);
+
+    const second = await newAdapterProcess();
+    expect(second.agent.sessions[second.sessionId].contextWindowSize).toBe(200_000);
+    expect(fs.readdirSync(stateDir)).toEqual([]);
+  });
+});
