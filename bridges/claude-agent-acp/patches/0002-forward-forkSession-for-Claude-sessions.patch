 });
 
+describe("Claude fork session metadata", () => {
+  it("forwards forkSession while preserving the SDK persistence option", async () => {
+    const agent = new ClaudeAcpAgent({ sessionUpdate: async () => {} } as unknown as AcpClient, {
+      log: () => {},
+      error: () => {},
+    });
+    const createSession = vi
+      .spyOn(
+        agent as unknown as {
+          createSession: (...args: unknown[]) => Promise<unknown>;
+        },
+        "createSession",
+      )
+      .mockResolvedValue({ sessionId: "child-session" });
+
+    await agent.newSession({
+      cwd: process.cwd(),
+      mcpServers: [],
+      _meta: {
+        claudeCode: {
+          options: {
+            resume: "parent-session",
+            forkSession: true,
+            persistSession: false,
+          },
+        },
+      },
+    } as any);
+
+    expect(createSession).toHaveBeenCalledWith(expect.objectContaining({ cwd: process.cwd() }), {
+      resume: "parent-session",
+      forkSession: true,
+    });
+  });
+});
+
 describe.skipIf(!process.env.RUN_INTEGRATION_TESTS)("ACP subprocess integration", () => {
   let child: ReturnType<typeof spawn>;
 
diff --git a/src/tests/create-session-options.test.ts b/src/tests/create-session-options.test.ts
index 11f55fa..def3f9c 100644
--- a/src/tests/create-session-options.test.ts
+++ b/src/tests/create-session-options.test.ts
@@ -99,6 +99,22 @@ describe("createSession options merging", () => {
     agent = new ClaudeAcpAgent(createMockClient());
   });
 
+  it("keys a resume + fork session by its own id, like a new session", async () => {
+    const cwd = process.cwd();
+    const { sessionId } = await agent.newSession({
+      cwd,
+      mcpServers: [],
+      _meta: { claudeCode: { options: { resume: "parent-session", forkSession: true } } },
+    });
+
+    expect(sessionId).not.toBe("parent-session");
+    expect(capturedOptions?.resume).toBe("parent-session");
+    expect(capturedOptions?.forkSession).toBe(true);
+    // The SDK must run the fork under the id ACP clients address it by; otherwise every
+    // update keyed by the SDK message's session_id names a session the client never saw.
+    expect(capturedOptions?.sessionId).toBe(sessionId);
+  });
+
