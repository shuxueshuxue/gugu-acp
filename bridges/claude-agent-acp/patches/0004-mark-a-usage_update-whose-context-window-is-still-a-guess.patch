+    injectSession(agent, [
+      createStreamEvent("message_start", {
+        model: "claude-opus-4-20250514",
+        usage: {
+          input_tokens: 1000,
+          output_tokens: 500,
+          cache_read_input_tokens: 200,
+          cache_creation_input_tokens: 100,
+        },
+      }),
+      createResultMessageWithModel({
+        modelUsage: {
+          "claude-opus-4-20250514": {
+            inputTokens: 1000,
+            outputTokens: 500,
+            cacheReadInputTokens: 200,
+            cacheCreationInputTokens: 100,
+            webSearchRequests: 0,
+            costUSD: 0.01,
+            contextWindow: 1000000,
+            maxOutputTokens: 16384,
+          },
+        },
+      }),
+      { type: "system", subtype: "session_state_changed", state: "idle" },
+    ]);
+
+    await agent.prompt({ sessionId: "test-session", prompt: [{ type: "text", text: "test" }] });
+
+    const [midStream, atResult] = updates
+      .filter((u: any) => u.update?.sessionUpdate === "usage_update")
+      .map((u: any) => u.update);
+    expect(midStream.size).toBe(200000);
+    expect(midStream._meta?.["_claude/contextWindowEstimated"]).toBe(true);
+    expect(atResult.size).toBe(1000000);
+    expect(atResult._meta?.["_claude/contextWindowEstimated"]).toBeUndefined();
+  });
+
+  it("does not mark a window that is already authoritative", async () => {
+    const { agent, updates } = createMockAgentWithCapture();
+    injectSession(agent, [
+      createStreamEvent("message_start", {
+        model: "claude-opus-4-20250514",
+        usage: {
+          input_tokens: 1000,
+          output_tokens: 500,
+          cache_read_input_tokens: 200,
+          cache_creation_input_tokens: 100,
+        },
+      }),
+      createResultMessageWithModel({
+        modelUsage: {
+          "claude-opus-4-20250514": {
+            inputTokens: 1000,
+            outputTokens: 500,
+            cacheReadInputTokens: 200,
+            cacheCreationInputTokens: 100,
+            webSearchRequests: 0,
+            costUSD: 0.01,
+            contextWindow: 1000000,
+            maxOutputTokens: 16384,
+          },
+        },
+      }),
+      { type: "system", subtype: "session_state_changed", state: "idle" },
+    ]);
+    agent.sessions["test-session"].contextWindowSize = 1000000;
+    agent.sessions["test-session"].contextWindowAuthoritative = true;
+
+    await agent.prompt({ sessionId: "test-session", prompt: [{ type: "text", text: "test" }] });
+
+    const usage = updates
+      .filter((u: any) => u.update?.sessionUpdate === "usage_update")
+      .map((u: any) => u.update);
+    expect(usage).toHaveLength(2);
+    for (const update of usage) {
+      expect(update.size).toBe(1000000);
+      expect(update._meta?.["_claude/contextWindowEstimated"]).toBeUndefined();
+    }
+  });
+
   it("includes the effective model id on usage_update notifications", async () => {
     const { agent, updates } = createMockAgentWithCapture();
     injectSession(agent, [
@@ -13981,9 +14064,11 @@ describe("result origin handling", () => {
 
     const usageUpdate = updates.find((u: any) => u.update?.sessionUpdate === "usage_update");
     expect(usageUpdate).toBeDefined();
+    // The result carries no modelUsage, so the window stays the unconfirmed guess.
     expect(usageUpdate.update._meta).toEqual({
